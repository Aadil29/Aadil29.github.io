---
import { siteConfig } from "../../config";
import "../../styles/global.css";

export function getStaticPaths() {
  return siteConfig.projects
    .filter((p) => p.slug)
    .map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const projectIndex = siteConfig.projects.findIndex((p) => p.slug === slug);
const project = siteConfig.projects[projectIndex];

if (!project) return Astro.redirect("/");

const details = project.details;
const hasImages = details?.images && details.images.length > 0;
const hasVideo = details?.videoUrl && details.videoUrl.length > 0;
const hasHighlights = details?.highlights && details.highlights.length > 0;
const hasRepo = details?.repoUrl && details.repoUrl.length > 0;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={`${project.name} — ${siteConfig.name}`}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{project.name} — {siteConfig.name}</title>
  </head>
  <body>
    <!-- Top bar -->
    <nav
      class="sticky top-0 z-50 bg-slate-900/80 backdrop-blur-sm border-b border-slate-700/50"
    >
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
        <a
          href="/#projects"
          class="flex items-center gap-2 text-slate-400 hover:text-slate-100 transition-colors duration-200 text-sm font-medium shrink-0"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M5 12l7 7M5 12l7-7" />
          </svg>
          Back
        </a>

        <!-- Prev / Next in nav -->
        <div class="flex items-center gap-4">
          {projectIndex > 0 ? (
            <a
              href={`/projects/${siteConfig.projects[projectIndex - 1].slug}`}
              class="group flex items-center gap-1.5 text-slate-400 hover:text-slate-100 transition-colors duration-200 text-sm"
              title={siteConfig.projects[projectIndex - 1].name}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-0.5 transition-transform duration-200">
                <path d="M19 12H5M5 12l7 7M5 12l7-7" />
              </svg>
              <span class="hidden sm:inline truncate max-w-[160px]">{siteConfig.projects[projectIndex - 1].name}</span>
              <span class="sm:hidden">Prev</span>
            </a>
          ) : <div />}

          <span class="text-slate-600 text-xs font-mono">{projectIndex + 1}/{siteConfig.projects.length}</span>

          {projectIndex < siteConfig.projects.length - 1 ? (
            <a
              href={`/projects/${siteConfig.projects[projectIndex + 1].slug}`}
              class="group flex items-center gap-1.5 text-slate-400 hover:text-slate-100 transition-colors duration-200 text-sm"
              title={siteConfig.projects[projectIndex + 1].name}
            >
              <span class="hidden sm:inline truncate max-w-[160px]">{siteConfig.projects[projectIndex + 1].name}</span>
              <span class="sm:hidden">Next</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform duration-200">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </a>
          ) : <div />}
        </div>
      </div>
    </nav>

    <main class="max-w-5xl mx-auto px-6 py-12 sm:py-16 md:py-24">
      <!-- Header -->
      <div class="mb-12">
        <span
          class="text-sm font-mono"
          style={`color: ${siteConfig.accentColor}`}
        >
          0{projectIndex + 1}
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-100 mt-2 mb-6 leading-tight">
          {project.name}
        </h1>

        <!-- Skills -->
        {
          project.skills && project.skills.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {project.skills.map((skill) => (
                <span class="px-3 py-1.5 bg-slate-800 text-slate-200 rounded-lg text-sm font-medium border border-slate-700">
                  {skill}
                </span>
              ))}
            </div>
          )
        }
      </div>

      <div
        class="w-full h-px mb-12"
        style={`background: linear-gradient(to right, ${siteConfig.accentColor}, transparent)`}
      >
      </div>

      <!-- Full description -->
      {
        details?.fullDescription && (
          <div class="mb-12">
            <h2 class="text-xl font-semibold text-slate-100 mb-4">Overview</h2>
            <p class="text-slate-400 text-lg leading-relaxed">
              {details.fullDescription}
            </p>
          </div>
        )
      }

      <!-- Highlights -->
      {
        hasHighlights && (
          <div class="mb-12">
            <h2 class="text-xl font-semibold text-slate-100 mb-4">
              Key Highlights
            </h2>
            <ul class="space-y-3">
              {details!.highlights!.map((point) => (
                <li class="flex items-start gap-3">
                  <span
                    class="mt-2 w-1.5 h-1.5 rounded-full flex-shrink-0"
                    style={`background-color: ${siteConfig.accentColor}`}
                  />
                  <span class="text-slate-400 text-base leading-relaxed">
                    {point}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <!-- Video — only shown when a URL is set -->
      {hasVideo && (
        <div class="mb-12">
          <h2 class="text-xl font-semibold text-slate-100 mb-4">Demo</h2>
          {details!.videoUrl!.endsWith(".mp4") ? (
            <video
              src={details!.videoUrl}
              class="w-full rounded-xl border border-slate-700 bg-slate-800"
              controls
              preload="metadata"
            />
          ) : (
            <div class="relative w-full aspect-video rounded-xl overflow-hidden border border-slate-700">
              <iframe
                src={details!.videoUrl}
                title={`${project.name} demo`}
                class="absolute inset-0 w-full h-full"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
          )}
        </div>
      )}

      <!-- Images — only shown when images are set -->
      {hasImages && (
        <div class="mb-12">
          <h2 class="text-xl font-semibold text-slate-100 mb-4">Screenshots</h2>
          <div class={`grid gap-4 ${details!.images!.length === 1 ? "grid-cols-1" : "grid-cols-1 sm:grid-cols-2"}`}>
            {details!.images!.map((src) => (
              <div class="rounded-xl overflow-hidden border border-slate-700 bg-slate-800">
                <img
                  src={src}
                  alt={project.name}
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Repo / external link -->
      {
        hasRepo && (
          <div class="mb-12">
            <a
              href={details!.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium text-white transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg"
              style={`background-color: ${siteConfig.accentColor}`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
              </svg>
              View Repository
            </a>
          </div>
        )
      }

    </main>
  </body>
</html>
