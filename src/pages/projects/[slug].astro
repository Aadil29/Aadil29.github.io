---
import Base from "../../layouts/Base.astro";
import Icon, { type IconName } from "../../components/Icon.astro";
import Picture from "../../components/Picture.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import { siteConfig } from "../../config";

export function getStaticPaths() {
  return (siteConfig.projects ?? [])
    .filter((p) => p.slug)
    .map((p) => ({ params: { slug: p.slug } }));
}

const projects = (siteConfig.projects ?? []).filter((p) => p.slug);
const { slug } = Astro.params;
const index = projects.findIndex((p) => p.slug === slug);
const project = projects[index];
if (!project) return Astro.redirect("/");

const d = project.details ?? {};
const images = d.images ?? [];
const highlights = d.highlights ?? [];
const sections = d.sections ?? [];
const stats = project.stats ?? [];
const flow = project.flow ?? [];
const frame = project.frame ?? "browser";
const video = d.videoUrl;
const isMp4 = !!video && /\.(mp4|webm)$/i.test(video);
const prev = index > 0 ? projects[index - 1] : undefined;
const next = index < projects.length - 1 ? projects[index + 1] : undefined;

const meta = [
  project.role && { label: "Role", value: project.role },
  project.timeframe && { label: "Timeframe", value: project.timeframe },
  project.team && { label: "Team", value: project.team },
].filter(Boolean) as { label: string; value: string }[];

const l = project.links ?? {};
const links = [
  l.demo && { label: "Live demo", href: l.demo, icon: "external" as IconName },
  l.repo && { label: "Source code", href: l.repo, icon: "github" as IconName },
  l.report && { label: "Read the report", href: l.report, icon: "file" as IconName },
  l.video && { label: "Watch walkthrough", href: l.video, icon: "play" as IconName },
].filter(Boolean) as { label: string; href: string; icon: IconName }[];

const cs = project.caseStudy ?? {};
const caseRows = [
  cs.problem && { heading: "Problem", body: cs.problem },
  cs.approach && { heading: "Approach", body: cs.approach },
  cs.result && { heading: "Result", body: cs.result },
  cs.lessons && { heading: "What I'd do differently", body: cs.lessons },
].filter(Boolean) as { heading: string; body: string }[];

// Sticky-left-heading rows: case-study fields first, then free-form sections.
const rows = [...caseRows, ...sections];
const showHeroMedia = images.length > 0 || !video;
---
<Base
  title={`${project.name} — ${siteConfig.name}`}
  description={project.description}
  path={`/projects/${project.slug}`}
  ogType="article"
>
  <article>
    <header class="pt-[52px]">
      <div class="container-x pt-12 sm:pt-16">
        <a href="/#projects" class="link text-[0.9375rem]">
          <Icon name="chevronLeft" size={16} /> All work
        </a>
        <div class="mt-10 max-w-[52rem]">
          {project.category && <p class="t-eyebrow load-in text-ink-2" style="--i:0">{project.category}</p>}
          <h1 class="t-h1 load-in mt-3 text-ink" style="--i:1">{project.name}</h1>
          <p class="t-lede load-in mt-6 text-ink-2" style="--i:2">{project.description}</p>
        </div>

        {meta.length > 0 && (
          <dl class="load-in mt-8 flex flex-wrap gap-x-10 gap-y-4" style="--i:3">
            {meta.map((m) => (
              <div>
                <dt class="t-eyebrow text-ink-3">{m.label}</dt>
                <dd class="mt-1 text-ink">{m.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {links.length > 0 && (
          <div class="load-in mt-8 flex flex-wrap gap-3" style="--i:4">
            {links.map((lk, i) => (
              <a href={lk.href} target="_blank" rel="noopener noreferrer" class:list={["btn", i === 0 ? "btn-primary" : "btn-secondary"]}>
                <Icon name={lk.icon} size={18} /> {lk.label}
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            ))}
          </div>
        )}
      </div>

      {showHeroMedia && (
        <div class="container-x load-in mt-12" style="--i:5">
          <div class:list={[images.length > 0 && frame === "browser" && "max-h-[46rem] overflow-hidden rounded-card"]}>
            <ProjectMedia project={project} variant="hero" eager index={index} />
          </div>
        </div>
      )}
    </header>

    {stats.length > 0 && (
      <section class="container-x mt-16" aria-label="Key figures">
        <dl class:list={["reveal grid gap-5", stats.length === 1 ? "sm:grid-cols-1" : stats.length === 2 ? "sm:grid-cols-2" : "sm:grid-cols-3"]}>
          {stats.map((s) => (
            <div class="card flex flex-col-reverse gap-2 p-7">
              <dt class="text-[0.9375rem] text-ink-2">{s.label}</dt>
              <dd class="t-mono font-semibold text-ink" style="font-size: clamp(2.25rem, 4vw, 3.25rem); line-height: 1">{s.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {d.fullDescription && (
      <section class="section-pad" aria-labelledby="overview">
        <div class="container-x grid gap-6 lg:grid-cols-12 lg:gap-10">
          <h2 id="overview" class="t-h2 reveal text-ink lg:col-span-4">Overview</h2>
          <p class="reveal text-[1.1875rem] leading-[1.55] text-ink-2 lg:col-span-8">{d.fullDescription}</p>
        </div>
      </section>
    )}

    {flow.length > 0 && (
      <section class="bg-bg-alt section-pad" aria-labelledby="flow-title">
        <div class="container-x">
          <h2 id="flow-title" class="t-h2 reveal text-ink">How it fits together</h2>
          <ol class="reveal mt-10 grid gap-4 md:grid-flow-col md:auto-cols-fr">
            {flow.map((step, i) => (
              <li class="card relative flex flex-col gap-3 p-6">
                <span class="t-mono text-[0.8125rem] font-semibold text-ink-3" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="font-semibold leading-snug text-ink">{step}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {highlights.length > 0 && (
      <section class="section-pad" aria-labelledby="highlights-title">
        <div class="container-x grid gap-6 lg:grid-cols-12 lg:gap-10">
          <h2 id="highlights-title" class="t-h2 reveal text-ink lg:col-span-4">Highlights</h2>
          <ol class="lg:col-span-8">
            {highlights.map((h, i) => (
              <li class="reveal flex gap-5 border-t border-hair py-6 first:border-t-0 first:pt-0">
                <span class="t-mono pt-1 text-[0.875rem] font-semibold text-accent-text" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="text-[1.0625rem] text-ink">{h}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {rows.length > 0 && (
      <section class="pb-[clamp(5rem,12vw,10rem)]" aria-label="Case study">
        <div class="container-x">
          {rows.map((row) => (
            <div class="reveal grid gap-4 border-t border-hair py-12 lg:grid-cols-12 lg:gap-10">
              <h2 class="t-h3 text-ink lg:col-span-4"><span class="lg:sticky lg:top-24 block">{row.heading}</span></h2>
              <div class="lg:col-span-8">
                {row.body && <p class="text-[1.0625rem] leading-[1.6] text-ink-2">{row.body}</p>}
                {"bullets" in row && row.bullets && row.bullets.length > 0 && (
                  <ul class="mt-4 space-y-4 text-ink-2">
                    {row.bullets.map((b) => (
                      <li class="flex gap-3">
                        <span class="mt-[0.65em] h-1.5 w-1.5 shrink-0 rounded-full bg-[color:var(--text-3)]" aria-hidden="true" />
                        <span class="leading-[1.6]">{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {video && (
      <section class="section-pad border-t border-hair" aria-labelledby="demo-title">
        <div class="container-x">
          <h2 id="demo-title" class="t-h2 reveal text-ink">Demo</h2>
          <p class="reveal mt-3 max-w-[40rem] text-ink-2">
            Screen recording of the project. It has no captions; the sections above describe what it shows.
          </p>
          <div class="reveal mt-10 overflow-hidden rounded-card border border-hair bg-surface">
            {isMp4 ? (
              <video
                class="block aspect-video w-full bg-bg-alt"
                controls
                playsinline
                preload="none"
                poster={d.videoPoster}
                aria-label={`${project.name} demo video`}
              >
                <source src={video} type="video/mp4" />
                <a href={video} class="link">Download the demo video</a>
              </video>
            ) : (
              <div class="relative aspect-video w-full">
                <iframe
                  src={video}
                  title={`${project.name} demo`}
                  class="absolute inset-0 h-full w-full"
                  loading="lazy"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    {images.length > 0 && (
      <section class="section-pad bg-bg-alt" aria-labelledby="gallery-title">
        <div class="container-x flex items-end justify-between gap-4">
          <div>
            <h2 id="gallery-title" class="t-h2 reveal text-ink">Gallery</h2>
            <p class="mt-2 text-[0.9375rem] text-ink-3">{images.length} screens. Scroll sideways or use the arrows.</p>
          </div>
          <div class="hidden gap-2 sm:flex" data-gallery-controls hidden>
            <button type="button" class="btn btn-secondary h-11 w-11 !px-0" data-dir="-1" aria-label="Previous screenshots"><Icon name="chevronLeft" size={20} /></button>
            <button type="button" class="btn btn-secondary h-11 w-11 !px-0" data-dir="1" aria-label="Next screenshots"><Icon name="chevronRight" size={20} /></button>
          </div>
        </div>
        <div class="mx-auto mt-10 max-w-[1120px] lg:px-[24px]">
          <ul
            class:list={["gallery", frame === "browser" && "gallery-desktop"]}
            tabindex="0"
            role="list"
            aria-label={`${project.name} screenshots`}
            data-gallery
          >
            {images.map((img) => (
              <li>
                <figure>
                  {frame === "browser" ? (
                    <div class="frame">
                      <div class="frame-bar" aria-hidden="true"><i /><i /><i /></div>
                      <Picture src={img.src} alt={img.alt} imgClass="dim block w-full h-auto" />
                    </div>
                  ) : (
                    <div class="frame">
                      <Picture src={img.src} alt={img.alt} imgClass="dim block h-[min(34rem,70svh)] w-auto" />
                    </div>
                  )}
                  {img.caption && <figcaption class="mt-4 text-[0.9375rem] text-ink-2">{img.caption}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {(prev || next) && (
      <nav class="container-x grid gap-5 py-16 sm:grid-cols-2" aria-label="More projects">
        {prev ? (
          <a href={`/projects/${prev.slug}`} class="card group flex flex-col gap-2 p-7 transition-shadow hover:shadow-[var(--shadow-md)]">
            <span class="t-eyebrow inline-flex items-center gap-1 text-ink-3"><Icon name="chevronLeft" size={14} /> Previous</span>
            <span class="t-h3 text-ink">{prev.name}</span>
          </a>
        ) : <span class="hidden sm:block" />}
        {next && (
          <a href={`/projects/${next.slug}`} class="card group flex flex-col items-end gap-2 p-7 text-right transition-shadow hover:shadow-[var(--shadow-md)]">
            <span class="t-eyebrow inline-flex items-center gap-1 text-ink-3">Next <Icon name="chevronRight" size={14} /></span>
            <span class="t-h3 text-ink">{next.name}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</Base>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((track) => {
    const controls = track.closest("section")?.querySelector<HTMLElement>("[data-gallery-controls]");
    if (!controls) return;
    controls.hidden = false;
    const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;
    controls.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((b) =>
      b.addEventListener("click", () => {
        const dir = Number(b.dataset.dir);
        track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: smooth ? "smooth" : "auto" });
      }),
    );
  });
</script>
