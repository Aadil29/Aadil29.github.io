---
import { siteConfig } from "../config";
const education = siteConfig.education ?? [];
---
{
  education.length > 0 && (
    <section id="education" class="section-pad bg-bg-alt" aria-labelledby="education-title">
      <div class="container-x">
        <h2 id="education-title" class="t-h1 reveal text-ink">Education.</h2>
        <ul class="mt-14 grid gap-5 md:grid-cols-2">
          {education.map((edu, i) => (
            <li class="card reveal p-8 sm:p-10" style={`--i:${i}`}>
              <h3 class="t-h2 text-ink">{edu.school}</h3>
              <p class="mt-3 text-ink-2">{edu.degree}</p>
              {edu.dateRange && <p class="mt-2 text-[0.9375rem] text-ink-3">{edu.dateRange}</p>}
              {edu.achievements && edu.achievements.length > 0 && (
                <ul class="mt-6 space-y-2 border-t border-hair pt-6 text-[0.9375rem] text-ink-2">
                  {edu.achievements.map((a) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-[color:var(--text-3)]" aria-hidden="true" />
                      <span>{a}</span>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
