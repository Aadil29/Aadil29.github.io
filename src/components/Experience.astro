---
import { siteConfig } from "../config";
const experience = siteConfig.experience ?? [];
---
{
  experience.length > 0 && (
    <section id="experience" class="section-pad" aria-labelledby="experience-title">
      <div class="container-x">
        <h2 id="experience-title" class="t-h1 reveal text-ink">Experience.</h2>

        <ol class="mt-14 border-t border-hair">
          {experience.map((exp) => (
            <li class="reveal grid gap-4 border-b border-hair py-10 lg:grid-cols-12 lg:gap-10">
              <div class="lg:col-span-4">
                <div class="lg:sticky lg:top-24">
                  <p class="t-h3 text-ink">{exp.company}</p>
                  <p class="mt-1 text-[0.9375rem] text-ink-3">{exp.dateRange}</p>
                </div>
              </div>
              <div class="lg:col-span-8">
                <h3 class="t-h2 text-ink">{exp.title}</h3>
                {exp.bullets.length > 0 && (
                  <ul class="mt-5 space-y-3 text-ink-2">
                    {exp.bullets.map((b) => (
                      <li class="flex gap-3">
                        <span class="mt-[0.65em] h-1.5 w-1.5 shrink-0 rounded-full bg-[color:var(--text-3)]" aria-hidden="true" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {exp.skills && exp.skills.length > 0 && (
                  <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies">
                    {exp.skills.map((t) => <li class="tag">{t}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
