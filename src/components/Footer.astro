---
import { siteConfig } from "../config";
import { navItems } from "../lib/nav";
import ThemeToggle from "./ThemeToggle.astro";

const items = navItems();
const { linkedin, github, twitter } = siteConfig.social;
const hasForm = !!siteConfig.contact?.formEndpoint;
const elsewhere = [
  hasForm && { label: "Contact form", href: "/#contact", external: false },
  linkedin && { label: "LinkedIn", href: linkedin, external: true },
  github && { label: "GitHub", href: github, external: true },
  twitter && { label: "X / Twitter", href: twitter, external: true },
  siteConfig.cvUrl && { label: "CV (PDF)", href: siteConfig.cvUrl, external: false },
].filter(Boolean) as { label: string; href: string; external: boolean }[];
---
<footer class="border-t border-hair bg-bg-alt text-[0.8125rem] text-ink-3">
  <div class="container-x py-10">
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-semibold text-ink">{siteConfig.name}</p>
        <p class="mt-1">{siteConfig.title}</p>
      </div>
      {items.length > 0 && (
        <nav aria-label="Footer">
          <h2 class="font-semibold text-ink-2">Navigate</h2>
          <ul class="mt-2 space-y-0">
            {items.map((i) => (
              <li><a href={`/#${i.id}`} class="inline-flex min-h-8 items-center hover:text-ink hover:underline">{i.label}</a></li>
            ))}
          </ul>
        </nav>
      )}
      {elsewhere.length > 0 && (
        <div>
          <h2 class="font-semibold text-ink-2">Elsewhere</h2>
          <ul class="mt-2">
            {elsewhere.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="inline-flex min-h-8 items-center hover:text-ink hover:underline"
                  {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
    <div class="mt-8 flex items-center justify-between gap-4 border-t border-hair pt-4">
      <p>© {new Date().getFullYear()} {siteConfig.name}</p>
      <ThemeToggle />
    </div>
  </div>
</footer>
