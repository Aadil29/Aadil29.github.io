---
import { siteConfig, type Project } from "../config";
import Icon from "./Icon.astro";
import ProjectMedia from "./ProjectMedia.astro";

const projects = siteConfig.projects ?? [];

// Bento spans on a 6-column grid, repeating every 4 projects so the layout
// stays balanced as projects are added: big feature (4x2), two side tiles
// (2x1), then a full-width row. A trailing lone tile spans the full row.
const pattern = [
  "md:col-span-6 lg:col-span-4 lg:row-span-2",
  "md:col-span-3 lg:col-span-2",
  "md:col-span-3 lg:col-span-2",
  "md:col-span-6 lg:col-span-6",
];
const spanFor = (i: number) => {
  const isLastAlone = i === projects.length - 1 && i % 4 === 1;
  return isLastAlone ? "md:col-span-6 lg:col-span-6" : pattern[i % 4];
};
const isWide = (i: number) => i % 4 === 3 || (i === projects.length - 1 && i % 4 === 1);
const isFeature = (i: number) => i % 4 === 0;

const hrefFor = (p: Project) => (p.slug ? `/projects/${p.slug}` : p.link || undefined);
const MAX_TAGS = 4;
---
{
  projects.length > 0 && (
    <section id="projects" class="section-pad" aria-labelledby="work-title">
      <div class="container-x">
        <div class="reveal max-w-[44rem]">
          <h2 id="work-title" class="t-h1 text-ink">Selected work.</h2>
          <p class="t-lede mt-5 text-ink-2">
            Security research, assessments and builds, from adversarial ML to cloud pipelines and full-stack apps.
          </p>
        </div>

        <ul class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-6 lg:auto-rows-[minmax(22rem,auto)]" role="list">
          {projects.map((project, i) => {
            const href = hrefFor(project);
            const external = !project.slug && !!project.link;
            const tags = project.skills ?? [];
            const extra = tags.length - MAX_TAGS;
            const wide = isWide(i);
            const feature = isFeature(i);
            const Tag = href ? "a" : "div";
            return (
              <li class:list={["reveal flex", spanFor(i)]} style={`--i:${i % 3}`}>
                <Tag
                  href={href}
                  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  class:list={["project-card w-full", wide && "lg:flex-row"]}
                  aria-labelledby={href ? `project-${i}-title` : undefined}
                >
                  <div class:list={["order-1 overflow-hidden", wide ? "lg:w-[55%] lg:order-2" : "", feature ? "flex-1 min-h-[16rem]" : "min-h-[14rem]"]}>
                    <ProjectMedia project={project} index={i} eager={i === 0} />
                  </div>
                  <div class:list={["order-2 flex flex-col p-6 sm:p-8", wide && "lg:order-1 lg:w-[45%] lg:justify-center"]}>
                    {project.category && <p class="t-eyebrow text-ink-3">{project.category}</p>}
                    <h3 id={`project-${i}-title`} class:list={["mt-2 text-ink", feature ? "t-h2" : "t-h3"]}>{project.name}</h3>
                    <p class:list={["mt-3 text-[0.9375rem] leading-relaxed text-ink-2", feature || wide ? "clamp-3" : "clamp-2"]}>
                      {project.description}
                    </p>
                    {tags.length > 0 && (
                      <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies">
                        {tags.slice(0, MAX_TAGS).map((t) => <li class="tag">{t}</li>)}
                        {extra > 0 && <li class="tag" aria-label={`and ${extra} more`}>+{extra}</li>}
                      </ul>
                    )}
                    {href && (
                      <span class="link mt-6 text-[1.0625rem]" aria-hidden="true">
                        {external ? "Visit project" : "View case study"}
                        <Icon name={external ? "external" : "chevronRight"} size={18} class="chev" />
                      </span>
                    )}
                  </div>
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}
