---
import { siteConfig } from "../config";
import { navItems } from "../lib/nav";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props { isHome?: boolean }
const { isHome = false } = Astro.props;
const items = navItems();
const hasContact = items.some((i) => i.id === "contact");
---
<header id="site-header" class="glass-bar fixed inset-x-0 top-0 z-50" data-home={isHome ? "" : undefined}>
  <nav class="container-x flex h-[52px] items-center justify-between gap-4" aria-label="Primary">
    <a href="/" class="text-[1.0625rem] font-semibold tracking-tight text-ink">{siteConfig.name}</a>

    <ul class="hidden items-center gap-1 md:flex">
      {items.map((item) => (
        <li>
          <a
            href={`/#${item.id}`}
            data-nav={item.id}
            class="nav-link inline-flex min-h-11 items-center rounded-full px-3 text-[0.875rem] text-ink-2 transition-colors hover:text-ink aria-[current]:text-ink aria-[current]:font-semibold"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1">
      <ThemeToggle />
      {siteConfig.cvUrl && (
        <a href={siteConfig.cvUrl} class="btn btn-secondary btn-sm hidden sm:inline-flex" download>
          CV <Icon name="download" size={16} />
        </a>
      )}
      {hasContact && (
        <a href="/#contact" class="btn btn-primary btn-sm hidden md:inline-flex">Contact</a>
      )}
      <button
        type="button"
        id="menu-button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span data-open-icon><Icon name="menu" size={22} /></span>
        <span data-close-icon class="hidden"><Icon name="close" size={22} /></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-b border-hair bg-surface md:hidden" style="box-shadow: var(--shadow-lg)">
    <ul class="container-x flex flex-col py-3">
      {items.map((item) => (
        <li class="border-b border-hair last:border-b-0">
          <a href={`/#${item.id}`} data-nav={item.id} class="nav-link flex min-h-12 items-center text-[1.0625rem] font-medium text-ink">
            {item.label}
          </a>
        </li>
      ))}
      {siteConfig.cvUrl && (
        <li class="pt-3">
          <a href={siteConfig.cvUrl} class="btn btn-secondary w-full" download>Download CV <Icon name="download" size={18} /></a>
        </li>
      )}
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById("site-header")!;
  const button = document.getElementById("menu-button")!;
  const menu = document.getElementById("mobile-menu")!;

  const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  function setOpen(open: boolean) {
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menu.classList.toggle("hidden", !open);
    button.querySelector("[data-open-icon]")!.classList.toggle("hidden", open);
    button.querySelector("[data-close-icon]")!.classList.toggle("hidden", !open);
  }
  button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      button.focus();
    }
  });
  matchMedia("(min-width: 768px)").addEventListener("change", (e) => e.matches && setOpen(false));

  // Active section highlight (home page only): colour change + aria-current.
  if (header.hasAttribute("data-home") && "IntersectionObserver" in window) {
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav]")];
    const ids = [...new Set(links.map((l) => l.dataset.nav!))];
    const sections = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) {
            links.forEach((l) => l.dataset.nav === e.target.id && l.removeAttribute("aria-current"));
            continue;
          }
          for (const l of links) {
            const active = l.dataset.nav === e.target.id;
            if (active) l.setAttribute("aria-current", "location");
            else l.removeAttribute("aria-current");
          }
        }
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
