---
import { siteConfig } from "../config";

const about = siteConfig.aboutMe ?? "";
const skills = siteConfig.skills ?? [];
const words = about.split(/\s+/).filter(Boolean);
const n = Math.max(words.length - 1, 1);
---
{
  (about || skills.length > 0) && (
    <section id="about" class="section-pad bg-bg-alt" aria-labelledby="about-title">
      <div class="container-x">
        <h2 id="about-title" class="t-h1 reveal text-ink">About.</h2>

        {about && (
          <p class="fill-text t-lede reveal mt-10 max-w-[52rem] text-ink" style="font-size: clamp(1.375rem, 1.6vw + 1rem, 2rem); line-height: 1.3; font-weight: 500">
            {words.map((w, i) => (
              <>{i > 0 && " "}<span class="w" style={`--p:${(i / n).toFixed(3)}`}>{w}</span></>
            ))}
          </p>
        )}

        {skills.length > 0 && (
          <div class="reveal mt-12 space-y-4 sm:space-y-2.5">
            {skills.map((group) => (
              <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-4">
                <h3 class="t-eyebrow shrink-0 text-ink-2 sm:w-40">{group.category}</h3>
                <ul class="flex flex-wrap gap-1.5" aria-label={`${group.category} skills`}>
                  {group.items.map((skill) => (
                    <li class="chip-sm">{skill}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}
