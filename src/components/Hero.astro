---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";

const hero = siteConfig.hero ?? {};
const eyebrow = hero.eyebrow ?? siteConfig.title;
// Current role, from the experience entry marked "Present" (single source).
const current =
  hero.showCurrentRole === false
    ? undefined
    : (siteConfig.experience ?? []).find((e) => /present/i.test(e.dateRange));
---
<section id="top" class="relative isolate flex min-h-[100svh] items-center overflow-hidden pt-[52px]" aria-labelledby="hero-name">
  <div class="blobs" aria-hidden="true"><span></span><span></span><span></span></div>

  <div class="container-x flex flex-col items-center py-20 text-center">
    {eyebrow && <p class="t-eyebrow load-in text-ink-2" style="--i:0">{eyebrow}</p>}
    <h1 id="hero-name" class="t-display load-in mt-4 text-ink" style="--i:1">{siteConfig.name}</h1>
    {hero.lede && <p class="t-lede load-in mt-6 max-w-[38rem] text-ink-2" style="--i:2">{hero.lede}</p>}

    {siteConfig.availability && (
      <p class="load-in mt-6 inline-flex items-center gap-2 text-[0.9375rem] text-ink-2" style="--i:3">
        <span class="inline-block h-2 w-2 rounded-full" style="background: var(--ok)" aria-hidden="true"></span>
        {siteConfig.availability}
        {siteConfig.location && <span class="text-ink-3">· {siteConfig.location}</span>}
      </p>
    )}
    {!siteConfig.availability && siteConfig.location && (
      <p class="load-in mt-6 text-[0.9375rem] text-ink-3" style="--i:3">{siteConfig.location}</p>
    )}

    {(hero.primaryCta || hero.secondaryCta || siteConfig.cvUrl) && (
      <div class="load-in mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-4" style="--i:4">
        {hero.primaryCta && <a href={hero.primaryCta.href} class="btn btn-primary">{hero.primaryCta.label}</a>}
        {siteConfig.cvUrl && (
          <a href={siteConfig.cvUrl} class="btn btn-secondary" download>
            Download CV <Icon name="download" size={18} />
          </a>
        )}
        {hero.secondaryCta && (
          <a href={hero.secondaryCta.href} class="link text-[1.0625rem]">
            {hero.secondaryCta.label}<Icon name="chevronRight" size={18} class="chev" />
          </a>
        )}
      </div>
    )}

    {current && (
      <p class="glass specular load-in mt-14 inline-flex max-w-full flex-wrap items-center justify-center gap-x-2 gap-y-1 rounded-[20px] px-6 py-4 text-[1rem] leading-snug" style="--i:5">
        <span class="text-ink-2">Currently</span>
        <span class="font-semibold text-ink">{current.title}</span>
        <span class="text-ink-2">at</span>
        <span class="font-semibold text-ink">{current.company}</span>
      </p>
    )}
  </div>
</section>
